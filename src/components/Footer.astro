---
---
<footer id="contacto">
  <div class="wrap">
    <!-- CTA Card Section -->
    <div class="contact-card">
      <div class="contact-badge">
        <span class="status-dot"></span>
        <span class="mono i18n-es">Hablemos</span>
        <span class="mono i18n-en">Let's connect</span>
      </div>

      <h2 class="contact-title">
        <span class="i18n-es">¿Tienes un proyecto en mente o una propuesta?</span>
        <span class="i18n-en">Have a project in mind or an opportunity?</span>
      </h2>
      
      <p class="contact-desc i18n-es">
        Estoy disponible para integrarme a equipos de producto, desarrollo de plataformas B2B y proyectos frontend con foco en rendimiento extremo y UI/UX moderna.
      </p>
      
      <p class="contact-desc i18n-en">
        I am available to join product teams, develop B2B platforms, and build frontend applications focused on extreme performance and modern UI/UX.
      </p>

      <div class="contact-actions">
        <!-- High-contrast Email Box with Instant Copy -->
        <div class="email-control" id="email-box">
          <a class="email-link" href="mailto:contacto@hugoadama.dev">
            <svg class="c-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
              <polyline points="22,6 12,13 2,6"/>
            </svg>
            <span class="mono email-text">contacto@hugoadama.dev</span>
          </a>

          <button id="copy-email-btn" class="copy-btn" type="button" aria-label="Copiar correo">
            <!-- Copy icon -->
            <svg id="copy-icon" class="copy-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect width="14" height="14" x="8" y="8" rx="2" ry="2"/>
              <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/>
            </svg>
            <!-- Check icon (hidden initially) -->
            <svg id="check-icon" class="copy-ico check-ico" style="display: none;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="20 6 9 17 4 12"/>
            </svg>
            <span id="copy-label" class="mono">
              <span class="i18n-es" id="label-es">Copiar</span>
              <span class="i18n-en" id="label-en">Copy</span>
            </span>
          </button>
        </div>

        <a class="c-btn" href="https://github.com/HugoAdama" target="_blank" rel="noopener noreferrer">
          <svg class="c-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/>
            <path d="M9 18c-4.51 2-5-2-7-2"/>
          </svg>
          <span>GitHub</span>
        </a>

        <a class="c-btn" href="https://www.linkedin.com/in/hugoadama" target="_blank" rel="noopener noreferrer">
          <svg class="c-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/>
            <rect x="2" y="9" width="4" height="12"/>
            <circle cx="4" cy="4" r="2"/>
          </svg>
          <span>LinkedIn</span>
        </a>
      </div>
    </div>

    <!-- Bottom Footer Bar -->
    <div class="footer-bottom">
      <div class="footer-left">
        <a href="/" class="footer-logo mono">hugoadama<span>.dev</span></a>
        <p class="footer-credit">
          <span class="i18n-es">Construido con Astro, React y TypeScript</span>
          <span class="i18n-en">Built with Astro, React & TypeScript</span>
        </p>
      </div>

      <div class="footer-right">
        <nav class="footer-nav">
          <a href="#proyectos">
            <span class="i18n-es">Proyectos</span>
            <span class="i18n-en">Projects</span>
          </a>
          <a href="#sobre-mi">
            <span class="i18n-es">Sobre mí</span>
            <span class="i18n-en">About</span>
          </a>
          <a href="#stack">
            <span class="i18n-es">Tech Stack</span>
            <span class="i18n-en">Tech Stack</span>
          </a>
        </nav>

        <a href="#top" class="top-link" aria-label="Volver arriba">
          <svg class="top-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="12" y1="19" x2="12" y2="5"></line>
            <polyline points="5 12 12 5 19 12"></polyline>
          </svg>
        </a>
      </div>
    </div>
  </div>
</footer>

<script>
  const copyBtn = document.getElementById('copy-email-btn');
  const copyIcon = document.getElementById('copy-icon');
  const checkIcon = document.getElementById('check-icon');
  const labelEs = document.getElementById('label-es');
  const labelEn = document.getElementById('label-en');

  if (copyBtn) {
    copyBtn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText('contacto@hugoadama.dev');
        
        // Show success state
        if (copyIcon && checkIcon) {
          copyIcon.style.display = 'none';
          checkIcon.style.display = 'inline-block';
        }
        if (labelEs && labelEn) {
          labelEs.textContent = '¡Copiado!';
          labelEn.textContent = 'Copied!';
        }
        copyBtn.classList.add('copied');

        setTimeout(() => {
          if (copyIcon && checkIcon) {
            copyIcon.style.display = 'inline-block';
            checkIcon.style.display = 'none';
          }
          if (labelEs && labelEn) {
            labelEs.textContent = 'Copiar';
            labelEn.textContent = 'Copy';
          }
          copyBtn.classList.remove('copied');
        }, 2200);
      } catch (err) {
        console.error('Error al copiar correo:', err);
      }
    });
  }
</script>

<style>
  footer {
    padding-top: 100px;
    padding-bottom: 70px;
    margin-top: 40px;
    position: relative;
  }

  .contact-card {
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 20px;
    padding: 56px 48px;
    box-shadow: 0 20px 48px -15px rgba(0, 0, 0, 0.4);
    position: relative;
    overflow: hidden;
    transition: all 0.25s ease;
  }

  [data-theme="light"] .contact-card {
    box-shadow: 0 16px 40px -12px rgba(15, 23, 42, 0.08);
  }

  .contact-card::before {
    content: "";
    position: absolute;
    top: 0;
    right: 0;
    width: 350px;
    height: 350px;
    background: radial-gradient(circle, rgba(111, 211, 255, 0.08) 0%, transparent 70%);
    pointer-events: none;
  }

  .contact-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 5px 12px;
    border-radius: 999px;
    background: rgba(142, 230, 184, 0.1);
    border: 1px solid rgba(142, 230, 184, 0.25);
    color: var(--mint);
    font-size: 0.78rem;
    font-weight: 600;
    margin-bottom: 20px;
  }

  [data-theme="light"] .contact-badge {
    background: rgba(5, 150, 105, 0.08);
    border-color: rgba(5, 150, 105, 0.25);
    color: #059669;
  }

  .status-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--mint);
    box-shadow: 0 0 8px var(--mint);
  }

  .contact-title {
    font-size: clamp(1.6rem, 3.2vw, 2.3rem);
    font-weight: 800;
    color: var(--text);
    line-height: 1.2;
    letter-spacing: -0.025em;
    margin: 0 0 16px;
    border: none;
    padding: 0;
  }

  .contact-title::after {
    display: none;
  }

  .contact-desc {
    color: var(--muted);
    font-size: 1.02rem;
    line-height: 1.65;
    max-width: 65ch;
    margin: 0 0 32px;
  }

  .contact-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    align-items: center;
  }

  /* Redesigned High-Contrast Email Box */
  .email-control {
    display: inline-flex;
    align-items: center;
    background: var(--bg2);
    border: 1.5px solid var(--line);
    border-radius: 12px;
    padding: 4px 6px 4px 14px;
    transition: all 0.2s ease;
  }

  .email-control:hover,
  .email-control:focus-within {
    border-color: var(--cyan);
    box-shadow: 0 4px 16px -4px rgba(111, 211, 255, 0.25);
  }

  .email-link {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--text);
    text-decoration: none;
    padding-right: 12px;
    font-size: 0.94rem;
    font-weight: 600;
  }

  .email-link:hover {
    color: var(--cyan);
  }

  .email-link .c-ico {
    color: var(--cyan);
  }

  .copy-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 14px;
    border-radius: 8px;
    background: var(--panel);
    border: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.78rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.18s ease;
  }

  .copy-btn:hover {
    color: var(--cyan);
    border-color: var(--cyan);
    background: rgba(111, 211, 255, 0.08);
  }

  .copy-btn.copied {
    color: var(--mint);
    border-color: var(--mint);
    background: rgba(142, 230, 184, 0.12);
  }

  .copy-ico {
    width: 14px;
    height: 14px;
  }

  .check-ico {
    color: var(--mint);
  }

  /* General Contact Buttons */
  .c-btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 12px 22px;
    border-radius: 12px;
    font-weight: 600;
    font-size: 0.94rem;
    text-decoration: none;
    color: var(--text);
    background: var(--bg2);
    border: 1.5px solid var(--line);
    transition: all 0.2s ease;
  }

  .c-btn:hover {
    border-color: var(--cyan);
    color: var(--cyan);
    transform: translateY(-2px);
    box-shadow: 0 8px 20px -8px rgba(0, 0, 0, 0.3);
  }

  .c-ico {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
  }

  /* Bottom bar */
  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 56px;
    padding-top: 32px;
    border-top: 1px solid var(--line);
    flex-wrap: wrap;
    gap: 20px;
  }

  .footer-left {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
  }

  .footer-logo {
    color: var(--text);
    font-weight: 700;
    font-size: 1.05rem;
    text-decoration: none;
  }

  .footer-logo span {
    color: var(--cyan);
  }

  .footer-credit {
    color: var(--muted);
    font-size: 0.85rem;
    margin: 0;
  }

  .footer-right {
    display: flex;
    align-items: center;
    gap: 24px;
  }

  .footer-nav {
    display: flex;
    gap: 18px;
  }

  .footer-nav a {
    color: var(--muted);
    font-size: 0.88rem;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .footer-nav a:hover {
    color: var(--cyan);
  }

  .top-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 8px;
    background: var(--bg2);
    border: 1px solid var(--line);
    color: var(--muted);
    transition: all 0.18s ease;
  }

  .top-link:hover {
    border-color: var(--cyan);
    color: var(--cyan);
    transform: translateY(-2px);
  }

  .top-ico {
    width: 16px;
    height: 16px;
  }

  @media (max-width: 768px) {
    footer {
      padding-top: 70px;
      padding-bottom: 50px;
    }

    .contact-card {
      padding: 36px 24px;
      border-radius: 16px;
    }

    .contact-actions {
      flex-direction: column;
      align-items: stretch;
    }

    .email-control {
      justify-content: space-between;
      width: 100%;
    }

    .c-btn {
      justify-content: center;
      width: 100%;
    }

    .footer-bottom {
      flex-direction: column;
      align-items: flex-start;
      gap: 16px;
    }

    .footer-right {
      width: 100%;
      justify-content: space-between;
    }
  }

  @media (max-width: 480px) {
    .email-control {
      flex-direction: column;
      align-items: stretch;
      padding: 12px;
      gap: 10px;
    }

    .email-link {
      padding-right: 0;
      justify-content: center;
      font-size: 0.85rem;
    }

    .copy-btn {
      justify-content: center;
      width: 100%;
    }
  }
</style>
