---
import { getAssetPath } from '../utils/paths';

const techStack = [
  {
    category_es: "Frontend & Frameworks Modernos",
    category_en: "Frontend & Modern Frameworks",
    icon: "code",
    items: ["Astro", "TypeScript", "JavaScript", "React", "Tailwind CSS", "HTML5", "CSS3"],
  },
  {
    category_es: "Backend & Bases de Datos",
    category_en: "Backend & Databases",
    icon: "database",
    items: ["Python", "PHP", "Laravel", "MySQL", "Microsoft SQL Server"],
  },
  {
    category_es: "Entorno, Despliegue & Diseño",
    category_en: "Environment, Deployment & Design",
    icon: "cloud",
    items: ["Git", "GitHub", "Cloudflare Pages", "Vercel", "Figma"],
  },
];
---
<section id="sobre-mi">
  <h2>
    <span class="i18n-es">Sobre mí</span>
    <span class="i18n-en">About me</span>
  </h2>
  
  <div class="about">
    <div class="photo-wrapper">
      <img
        src={getAssetPath('hugo-adama.png')}
        alt="Hugo Adama"
        class="photo"
        loading="lazy"
        decoding="async"
        width="200"
        height="200"
      />
    </div>

    <div class="about-info">
      <p class="about-lead i18n-es">
        Desarrollador <strong>Frontend & Full-Stack</strong> enfocado en crear experiencias digitales que combinan diseño de alto impacto, accesibilidad y velocidad de carga extrema.
      </p>

      <p class="about-lead i18n-en">
        <strong>Frontend & Full-Stack Developer</strong> dedicated to crafting digital experiences that combine high visual impact, strict accessibility, and blazing fast performance.
      </p>

      <ul class="highlights">
        <li>
          <div class="hl-icon-box">
            <svg class="hl-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z"></path>
              <path d="m12 15-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-2.05 11a22.35 22.35 0 0 1-4 2z"></path>
              <path d="M9 12H4s.55-3.03 2-4c1.62-1.08 5 0 5 0"></path>
              <path d="M12 15v5s3.03-.55 4-2c1.08-1.62 0-5 0-5"></path>
            </svg>
          </div>
          <div>
            <span class="i18n-es"><strong>Enfoque actual:</strong> Construyendo plataformas web de alto rendimiento y arquitectura JAMstack ultrarrápida con <strong>Astro</strong>, <strong>TypeScript</strong> y <strong>Tailwind CSS</strong>.</span>
            <span class="i18n-en"><strong>Current focus:</strong> Building high-performance web platforms and ultra-fast JAMstack architecture with <strong>Astro</strong>, <strong>TypeScript</strong>, and <strong>Tailwind CSS</strong>.</span>
          </div>
        </li>

        <li>
          <div class="hl-icon-box">
            <svg class="hl-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect width="20" height="14" x="2" y="7" rx="2" ry="2"></rect>
              <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
            </svg>
          </div>
          <div>
            <span class="i18n-es"><strong>Experiencia:</strong> Desarrollo de soluciones corporativas B2B, catálogos interactivos, sistemas comerciales y aplicaciones a medida con foco en Core Web Vitals y conversión.</span>
            <span class="i18n-en"><strong>Experience:</strong> Developing B2B corporate solutions, interactive catalogs, commercial systems, and custom web apps with a focus on Core Web Vitals and conversion.</span>
          </div>
        </li>

        <li>
          <div class="hl-icon-box">
            <svg class="hl-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
            </svg>
          </div>
          <div>
            <span class="i18n-es"><strong>Filosofía:</strong> Cero código muerto, interfaces limpias, accesibilidad estricta y experiencia fluida (<em>Zero-FOUC</em>).</span>
            <span class="i18n-en"><strong>Philosophy:</strong> Zero dead code, clean interfaces, strict accessibility, and seamless user experience (<em>Zero-FOUC</em>).</span>
          </div>
        </li>
      </ul>

      <dl class="facts">
        <dt>
          <span class="i18n-es">Ubicación</span>
          <span class="i18n-en">Location</span>
        </dt>
        <dd class="fact-dd">
          <svg class="fact-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
            <circle cx="12" cy="10" r="3"></circle>
          </svg>
          Lima, Perú
        </dd>

        <dt>
          <span class="i18n-es">Especialidad</span>
          <span class="i18n-en">Specialty</span>
        </dt>
        <dd>
          <span class="i18n-es">Rendimiento Web, JAMstack & UI/UX</span>
          <span class="i18n-en">Web Performance, JAMstack & UI/UX</span>
        </dd>

        <dt>
          <span class="i18n-es">Disponibilidad</span>
          <span class="i18n-en">Availability</span>
        </dt>
        <dd>
          <span class="i18n-es">Soluciones a medida, B2B y proyectos frontend</span>
          <span class="i18n-en">Custom solutions, B2B & frontend projects</span>
        </dd>
      </dl>
    </div>
  </div>
</section>

<section id="stack">
  <h2>
    <span class="i18n-es">Tech Stack & Herramientas</span>
    <span class="i18n-en">Tech Stack & Tools</span>
  </h2>
  <div class="stack-grid">
    {techStack.map((group) => (
      <div class="stack-card">
        <div class="stack-card-header">
          {group.icon === "code" && (
            <svg class="category-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="16 18 22 12 16 6"></polyline>
              <polyline points="8 6 2 12 8 18"></polyline>
            </svg>
          )}
          {group.icon === "database" && (
            <svg class="category-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <ellipse cx="12" cy="5" rx="9" ry="3"></ellipse>
              <path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"></path>
              <path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"></path>
            </svg>
          )}
          {group.icon === "cloud" && (
            <svg class="category-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9Z"></path>
            </svg>
          )}
          <h3>
            <span class="i18n-es">{group.category_es}</span>
            <span class="i18n-en">{group.category_en}</span>
          </h3>
        </div>
        <div class="stack-chips">
          {group.items.map((tech) => (
            <span class="chip">{tech}</span>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  .photo-wrapper {
    position: relative;
    border-radius: 16px;
    padding: 3px;
    background: linear-gradient(135deg, rgba(111, 211, 255, 0.4), rgba(182, 156, 255, 0.2), transparent);
    width: fit-content;
  }

  [data-theme="light"] .photo-wrapper {
    background: linear-gradient(135deg, rgba(2, 132, 199, 0.3), rgba(124, 58, 237, 0.2), transparent);
    box-shadow: 0 8px 24px -4px rgba(15, 23, 42, 0.1);
  }

  .photo {
    display: block;
    width: 180px;
    height: 180px;
    border-radius: 14px;
    object-fit: cover;
    background: var(--bg2);
  }

  .about-lead {
    font-size: 1.05rem;
    color: var(--text);
    line-height: 1.6;
  }

  .highlights {
    list-style: none;
    padding: 0;
    margin: 22px 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .highlights li {
    display: flex;
    gap: 14px;
    align-items: flex-start;
    color: var(--muted);
    font-size: 0.96rem;
    line-height: 1.55;
  }

  .hl-icon-box {
    width: 32px;
    height: 32px;
    border-radius: 8px;
    background: rgba(111, 211, 255, 0.1);
    border: 1px solid rgba(111, 211, 255, 0.2);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    margin-top: 2px;
  }

  [data-theme="light"] .hl-icon-box {
    background: rgba(2, 132, 199, 0.08);
    border-color: rgba(2, 132, 199, 0.2);
  }

  .hl-svg {
    width: 17px;
    height: 17px;
    color: var(--cyan);
  }

  .highlights strong {
    color: var(--text);
  }

  .fact-dd {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .fact-icon {
    width: 15px;
    height: 15px;
    color: var(--cyan);
  }

  .stack-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(290px, 1fr));
    gap: 20px;
    margin-top: 16px;
  }

  .stack-card {
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 24px;
    transition: all 0.2s ease;
  }

  [data-theme="light"] .stack-card {
    box-shadow: 0 4px 16px -2px rgba(15, 23, 42, 0.05);
  }

  .stack-card:hover {
    border-color: var(--cyan);
    transform: translateY(-2px);
    box-shadow: 0 12px 28px -12px rgba(0, 0, 0, 0.5);
  }

  [data-theme="light"] .stack-card:hover {
    box-shadow: 0 12px 28px -8px rgba(15, 23, 42, 0.12);
  }

  .stack-card-header {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 16px;
  }

  .category-icon {
    width: 18px;
    height: 18px;
    color: var(--mint);
    flex-shrink: 0;
  }

  .stack-card h3 {
    font-size: 0.95rem;
    color: var(--mint);
    font-family: 'JetBrains Mono', monospace;
    font-weight: 600;
  }

  .stack-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .chip {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.8rem;
    padding: 5px 12px;
    border-radius: 6px;
    background: var(--bg2);
    color: var(--text);
    border: 1px solid var(--line);
    transition: all 0.15s ease;
  }

  .chip:hover {
    border-color: var(--cyan);
    color: var(--cyan);
  }

  @media (max-width: 640px) {
    .photo {
      width: 140px;
      height: 140px;
    }
  }
</style>
