---
import CodeWindow from './CodeWindow.astro';
import { getAssetPath } from '../utils/paths';
---
<section class="hero">
  <div class="hero-content">
    <div class="status-badge">
      <span class="status-dot"></span>
      <span class="mono i18n-es">Disponible para proyectos</span>
      <span class="mono i18n-en">Available for projects</span>
    </div>
    
    <h1>Hugo Adama</h1>
    
    <p class="hero-sub i18n-es">
      <strong>Frontend & Full-Stack Developer</strong> especializado en rendimiento web, Core Web Vitals y UI/UX moderna. Construyo soluciones corporativas B2B y aplicaciones ultrarrápidas con <strong>Astro</strong>, <strong>TypeScript</strong> y <strong>React</strong>.
    </p>

    <p class="hero-sub i18n-en">
      <strong>Frontend & Full-Stack Developer</strong> specializing in web performance, Core Web Vitals, and modern UI/UX. Building high-performance B2B corporate platforms and ultra-fast web apps with <strong>Astro</strong>, <strong>TypeScript</strong>, and <strong>React</strong>.
    </p>

    <div class="btns">
      <a class="btn primary-btn" href="#proyectos">
        <svg class="btn-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="7 13 12 18 17 13"></polyline>
          <polyline points="7 6 12 11 17 6"></polyline>
        </svg>
        <span class="i18n-es">Ver proyectos</span>
        <span class="i18n-en">View projects</span>
      </a>

      <a class="btn cv-btn i18n-es" href={getAssetPath('cv-hugo-adama-es.pdf')} target="_blank" rel="noopener noreferrer" download="CV-Hugo-Adama-ES.pdf">
        <svg class="btn-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
          <polyline points="7 10 12 15 17 10"></polyline>
          <line x1="12" y1="15" x2="12" y2="3"></line>
        </svg>
        <span>Descargar CV</span>
      </a>

      <a class="btn cv-btn i18n-en" href={getAssetPath('cv-hugo-adama-en.pdf')} target="_blank" rel="noopener noreferrer" download="CV-Hugo-Adama-EN.pdf">
        <svg class="btn-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
          <polyline points="7 10 12 15 17 10"></polyline>
          <line x1="12" y1="15" x2="12" y2="3"></line>
        </svg>
        <span>Download CV</span>
      </a>
      
      <a class="btn alt-btn" href="#contacto">
        <svg class="btn-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
          <polyline points="22,6 12,13 2,6"></polyline>
        </svg>
        <span class="i18n-es">Contactar</span>
        <span class="i18n-en">Get in touch</span>
      </a>
      
      <a class="btn icon-btn" href="https://github.com/HugoAdama" target="_blank" rel="noopener noreferrer" aria-label="GitHub de Hugo Adama">
        <svg class="btn-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path>
          <path d="M9 18c-4.51 2-5-2-7-2"></path>
        </svg>
        <span>GitHub</span>
      </a>
    </div>
  </div>
  
  <div class="hero-window">
    <CodeWindow />
  </div>
</section>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    gap: 40px;
    align-items: center;
    padding: 70px 0 30px;
  }

  .status-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 5px 12px;
    border-radius: 999px;
    background: rgba(142, 230, 184, 0.1);
    border: 1px solid rgba(142, 230, 184, 0.25);
    color: var(--mint);
    font-size: 0.78rem;
    font-weight: 600;
    margin-bottom: 18px;
  }

  :global([data-theme="light"]) .status-badge {
    background: rgba(5, 150, 105, 0.08);
    border-color: rgba(5, 150, 105, 0.25);
    color: #059669;
  }

  .status-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--mint);
    box-shadow: 0 0 10px var(--mint);
    animation: pulse 2s infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.5; transform: scale(0.85); }
  }

  .hero h1 {
    font-size: clamp(2.4rem, 5vw, 3.8rem);
    font-weight: 800;
    line-height: 1.06;
    letter-spacing: -0.035em;
    color: var(--text);
  }

  .hero-sub {
    margin-top: 18px;
    color: var(--muted);
    font-size: 1.08rem;
    line-height: 1.65;
    max-width: 48ch;
  }

  .hero-sub strong {
    color: var(--text);
    font-weight: 600;
  }

  .btns {
    margin-top: 28px;
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    align-items: center;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 11px 20px;
    border-radius: 10px;
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    transition: transform 0.22s var(--ease-spring), background 0.2s ease, border-color 0.2s ease, box-shadow 0.22s var(--ease-spring), color 0.18s ease;
    will-change: transform;
    backface-visibility: hidden;
  }

  .btn:active {
    transform: translateY(0) scale(0.96);
  }

  /* High contrast primary button */
  .primary-btn {
    background: var(--cyan);
    color: #0F172A;
    font-weight: 700;
    border: 1px solid var(--cyan);
    box-shadow: 0 4px 14px -2px rgba(2, 132, 199, 0.45), inset 0 1px 0 rgba(255, 255, 255, 0.45);
  }

  :global([data-theme="light"]) .primary-btn {
    background: var(--cyan);
    color: #FFFFFF;
    box-shadow: 0 4px 14px -2px rgba(2, 132, 199, 0.4), inset 0 1px 0 rgba(255, 255, 255, 0.35);
  }

  .primary-btn:hover {
    background: #38BDF8;
    border-color: #38BDF8;
    transform: translateY(-2px);
    box-shadow: 0 8px 22px -4px rgba(2, 132, 199, 0.55), inset 0 1px 0 rgba(255, 255, 255, 0.5);
  }

  /* Download CV button */
  .cv-btn {
    background: var(--glass-surface), var(--panel);
    color: var(--text);
    border: 1.5px solid rgba(182, 156, 255, 0.55);
    backdrop-filter: var(--glass-blur);
    -webkit-backdrop-filter: var(--glass-blur);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.22), 0 2px 8px rgba(0, 0, 0, 0.15);
  }

  :global([data-theme="light"]) .cv-btn {
    background: var(--glass-surface), #FFFFFF;
    border-color: rgba(124, 58, 237, 0.45);
    color: #7C3AED;
    box-shadow: inset 0 1px 0 #FFFFFF, 0 2px 8px rgba(124, 58, 237, 0.12);
  }

  .cv-btn:hover {
    background: var(--violet);
    color: #FFFFFF;
    border-color: var(--violet);
    transform: translateY(-2px);
    box-shadow: 0 8px 22px -4px rgba(182, 156, 255, 0.5), inset 0 1px 0 rgba(255, 255, 255, 0.4);
  }

  /* Alt contact button */
  .alt-btn {
    background: var(--glass-surface), var(--panel);
    color: var(--text);
    border: 1.5px solid var(--line);
    backdrop-filter: var(--glass-blur);
    -webkit-backdrop-filter: var(--glass-blur);
    box-shadow: var(--glass-bevel), 0 2px 8px rgba(0, 0, 0, 0.15);
  }

  :global([data-theme="light"]) .alt-btn {
    background: var(--glass-surface), #FFFFFF;
    color: #0F172A;
    border-color: var(--line);
    box-shadow: inset 0 1px 0 #FFFFFF, 0 2px 6px rgba(0, 0, 0, 0.04);
  }

  .alt-btn:hover {
    border-color: var(--cyan);
    color: var(--cyan);
    transform: translateY(-2px);
    box-shadow: var(--glass-bevel-hover), 0 6px 16px -2px rgba(2, 132, 199, 0.25);
  }

  /* Icon button */
  .icon-btn {
    background: var(--glass-surface), var(--panel);
    color: var(--text);
    border: 1.5px solid var(--line);
    padding: 11px 16px;
    backdrop-filter: var(--glass-blur);
    -webkit-backdrop-filter: var(--glass-blur);
    box-shadow: var(--glass-bevel), 0 2px 8px rgba(0, 0, 0, 0.15);
  }

  :global([data-theme="light"]) .icon-btn {
    background: var(--glass-surface), #FFFFFF;
    color: #0F172A;
    border-color: var(--line);
    box-shadow: inset 0 1px 0 #FFFFFF, 0 2px 6px rgba(0, 0, 0, 0.04);
  }

  .icon-btn:hover {
    border-color: var(--violet);
    color: var(--text);
    transform: translateY(-2px);
    box-shadow: 0 6px 16px -2px rgba(182, 156, 255, 0.25);
  }

  .icon-btn:hover {
    border-color: var(--violet);
    color: var(--text);
    transform: translateY(-2px);
    box-shadow: 0 6px 16px -2px rgba(182, 156, 255, 0.25);
  }

  .btn-icon {
    width: 17px;
    height: 17px;
    flex-shrink: 0;
  }

  @media (max-width: 860px) {
    .hero {
      grid-template-columns: 1fr;
      padding-top: 40px;
      gap: 32px;
    }

    .hero-sub {
      max-width: 100%;
    }
  }

  @media (max-width: 580px) {
    .btns {
      flex-direction: column;
      align-items: stretch;
    }

    .btn {
      justify-content: center;
    }
  }
</style>
