---
// Silky ethereal Aurora Borealis background engine with high-contrast text protection
---
<div class="aurora-bg" aria-hidden="true">
  <!-- Glowing ambient illumination orbs -->
  <div class="aurora-orb orb-emerald"></div>
  <div class="aurora-orb orb-cyan"></div>
  <div class="aurora-orb orb-violet"></div>

  <!-- Real-time Silky Aurora Borealis Canvas -->
  <canvas id="aurora-borealis-canvas" class="aurora-canvas"></canvas>

  <!-- Atmospheric contrast shield to protect text readability -->
  <div class="contrast-shield"></div>
</div>

<script>
  function initAuroraBorealis() {
    const canvas = document.getElementById('aurora-borealis-canvas') as HTMLCanvasElement | null;
    if (!canvas) return;

    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    const mediaQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
    let prefersReducedMotion = mediaQuery.matches;
    mediaQuery.addEventListener('change', (e) => {
      prefersReducedMotion = e.matches;
    });

    let width = 0;
    let height = 0;
    let dpr = 1;

    interface Star {
      x: number;
      y: number;
      size: number;
      alpha: number;
      phase: number;
    }
    let stars: Star[] = [];

    function initStars() {
      stars = [];
      const count = Math.min(Math.floor((width * height) / 16000), 60);
      for (let i = 0; i < count; i++) {
        stars.push({
          x: Math.random() * width,
          y: Math.random() * height * 0.8,
          size: Math.random() * 1.4 + 0.6,
          alpha: Math.random() * 0.6 + 0.2,
          phase: Math.random() * Math.PI * 2,
        });
      }
    }

    function resize() {
      if (!canvas) return;
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      width = window.innerWidth;
      height = window.innerHeight;
      canvas.width = width * dpr;
      canvas.height = height * dpr;
      canvas.style.width = `${width}px`;
      canvas.style.height = `${height}px`;
      if (ctx) {
        ctx.scale(dpr, dpr);
      }
      initStars();
    }

    resize();
    window.addEventListener('resize', resize, { passive: true });

    let mouseX = width * 0.5;
    let mouseY = height * 0.4;
    let targetMouseX = mouseX;
    let targetMouseY = mouseY;

    window.addEventListener(
      'pointermove',
      (e) => {
        targetMouseX = e.clientX;
        targetMouseY = e.clientY;
      },
      { passive: true }
    );

    // 3 layered undulating aurora curtains with silky color transitions
    const curtains = [
      {
        baseYRatio: 0.32,
        curtainHeight: 280,
        wavelength: 0.0020,
        speed: 0.008,
        foldFreq: 0.0045,
        foldSpeed: 0.012,
        baseAmp: 55,
        phase: 0,
        darkColors: {
          top: 'rgba(182, 156, 255, 0.18)',     // High-altitude violet
          mid: 'rgba(111, 211, 255, 0.22)',     // Electric cyan
          base: 'rgba(142, 230, 184, 0.26)',    // Ionized oxygen emerald/mint
        },
        lightColors: {
          top: 'rgba(124, 58, 237, 0.08)',
          mid: 'rgba(2, 132, 199, 0.12)',
          base: 'rgba(5, 150, 105, 0.14)',
        },
      },
      {
        baseYRatio: 0.52,
        curtainHeight: 340,
        wavelength: 0.0024,
        speed: -0.010,
        foldFreq: 0.0055,
        foldSpeed: 0.015,
        baseAmp: 65,
        phase: 2.2,
        darkColors: {
          top: 'rgba(182, 156, 255, 0.22)',
          mid: 'rgba(111, 211, 255, 0.28)',
          base: 'rgba(142, 230, 184, 0.22)',
        },
        lightColors: {
          top: 'rgba(124, 58, 237, 0.10)',
          mid: 'rgba(2, 132, 199, 0.15)',
          base: 'rgba(5, 150, 105, 0.10)',
        },
      },
      {
        baseYRatio: 0.74,
        curtainHeight: 260,
        wavelength: 0.0016,
        speed: 0.007,
        foldFreq: 0.0038,
        foldSpeed: 0.009,
        baseAmp: 45,
        phase: 4.4,
        darkColors: {
          top: 'rgba(111, 211, 255, 0.18)',
          mid: 'rgba(182, 156, 255, 0.24)',
          base: 'rgba(142, 230, 184, 0.14)',
        },
        lightColors: {
          top: 'rgba(2, 132, 199, 0.10)',
          mid: 'rgba(124, 58, 237, 0.12)',
          base: 'rgba(5, 150, 105, 0.06)',
        },
      },
    ];

    let isVisible = true;
    document.addEventListener('visibilitychange', () => {
      isVisible = !document.hidden;
      if (isVisible) {
        lastTime = performance.now();
        render();
      }
    });

    let lastTime = performance.now();
    let globalTime = 0;

    function render() {
      if (!isVisible) return;

      const now = performance.now();
      const delta = Math.min((now - lastTime) / 1000, 0.1);
      lastTime = now;

      if (!prefersReducedMotion) {
        globalTime += delta;
      }

      if (!ctx || !canvas) return;

      mouseX += (targetMouseX - mouseX) * 0.035;
      mouseY += (targetMouseY - mouseY) * 0.035;

      ctx.clearRect(0, 0, width, height);

      const isLight = document.documentElement.getAttribute('data-theme') === 'light';

      // 1. Subtle celestial stars
      if (!isLight) {
        for (let i = 0; i < stars.length; i++) {
          const s = stars[i];
          const twinkle = Math.sin(globalTime * 1.5 + s.phase) * 0.35 + 0.65;
          ctx.beginPath();
          ctx.arc(s.x, s.y, s.size, 0, Math.PI * 2);
          ctx.fillStyle = `rgba(240, 244, 255, ${s.alpha * twinkle * 0.7})`;
          ctx.fill();
        }
      }

      ctx.globalCompositeOperation = isLight ? 'multiply' : 'screen';

      // 2. Render each silky undulating aurora curtain
      for (let c = 0; c < curtains.length; c++) {
        const curtain = curtains[c];

        if (!prefersReducedMotion) {
          curtain.phase += curtain.speed * delta * 60;
        }

        const colors = isLight ? curtain.lightColors : curtain.darkColors;
        const baseY = height * curtain.baseYRatio;
        const step = 14;

        // Draw the filled flowing wave body with vertical celestial gradient
        ctx.beginPath();
        ctx.moveTo(0, height);

        for (let x = 0; x <= width + step; x += step) {
          const distToMouse = Math.abs(x - mouseX);
          const mouseInfl = Math.max(0, 1 - distToMouse / (width * 0.45));
          const amp = curtain.baseAmp + mouseInfl * 20;

          const y1 = Math.sin(x * curtain.wavelength + curtain.phase) * amp;
          const y2 = Math.cos(x * curtain.foldFreq + curtain.phase * 1.3) * (amp * 0.45);
          const y3 = Math.sin(x * 0.007 + globalTime * 0.7) * 7;
          const spineY = baseY + y1 + y2 + y3;

          if (x === 0) {
            ctx.lineTo(0, spineY);
          } else {
            ctx.lineTo(x, spineY);
          }
        }

        ctx.lineTo(width, height);
        ctx.closePath();

        const grad = ctx.createLinearGradient(0, baseY - curtain.curtainHeight * 0.7, 0, height);
        grad.addColorStop(0, 'rgba(0,0,0,0)');
        grad.addColorStop(0.2, colors.top);
        grad.addColorStop(0.55, colors.mid);
        grad.addColorStop(0.85, colors.base);
        grad.addColorStop(1, 'rgba(0,0,0,0)');

        ctx.fillStyle = grad;
        ctx.fill();

        // Stroke the luminous crest line
        ctx.beginPath();
        for (let x = 0; x <= width + step; x += step) {
          const distToMouse = Math.abs(x - mouseX);
          const mouseInfl = Math.max(0, 1 - distToMouse / (width * 0.45));
          const amp = curtain.baseAmp + mouseInfl * 20;

          const y1 = Math.sin(x * curtain.wavelength + curtain.phase) * amp;
          const y2 = Math.cos(x * curtain.foldFreq + curtain.phase * 1.3) * (amp * 0.45);
          const y3 = Math.sin(x * 0.007 + globalTime * 0.7) * 7;
          const spineY = baseY + y1 + y2 + y3;

          if (x === 0) {
            ctx.moveTo(x, spineY);
          } else {
            ctx.lineTo(x, spineY);
          }
        }
        ctx.strokeStyle = colors.base;
        ctx.lineWidth = 1.8;
        ctx.stroke();
      }

      ctx.globalCompositeOperation = 'source-over';
      requestAnimationFrame(render);
    }

    render();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAuroraBorealis);
  } else {
    initAuroraBorealis();
  }
  document.addEventListener('astro:page-load', initAuroraBorealis);
</script>

<style>
  .aurora-bg {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: -2;
    overflow: hidden;
    width: 100vw;
    height: 100vh;
    contain: strict;
    background: var(--bg);
  }

  /* Silky blurred canvas so wave motion is fluid without harsh stripes */
  .aurora-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    display: block;
    filter: blur(28px);
    opacity: 0.65;
  }

  [data-theme="light"] .aurora-canvas {
    filter: blur(34px);
    opacity: 0.35;
  }

  /* Text protection contrast shield (subtle dark vignette in reading area) */
  .contrast-shield {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(ellipse at 50% 30%, rgba(10, 14, 31, 0.45) 0%, rgba(10, 14, 31, 0.85) 100%);
  }

  [data-theme="light"] .contrast-shield {
    background: radial-gradient(ellipse at 50% 30%, rgba(244, 247, 252, 0.4) 0%, rgba(244, 247, 252, 0.85) 100%);
  }

  /* Soft glowing ambient orbs behind curtains */
  .aurora-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(100px);
    opacity: 0.28;
    will-change: transform, opacity;
    mix-blend-mode: screen;
  }

  [data-theme="light"] .aurora-orb {
    mix-blend-mode: multiply;
    opacity: 0.12;
    filter: blur(110px);
  }

  .orb-emerald {
    top: 15%;
    left: 8%;
    width: 48vw;
    height: 48vw;
    max-width: 550px;
    max-height: 550px;
    background: radial-gradient(circle, var(--mint) 0%, rgba(142, 230, 184, 0.02) 70%, transparent 100%);
    animation: drift-orb-emerald 16s ease-in-out infinite alternate;
  }

  .orb-cyan {
    top: 40%;
    right: 6%;
    width: 52vw;
    height: 52vw;
    max-width: 600px;
    max-height: 600px;
    background: radial-gradient(circle, var(--cyan) 0%, rgba(111, 211, 255, 0.02) 70%, transparent 100%);
    animation: drift-orb-cyan 18s ease-in-out infinite alternate;
  }

  .orb-violet {
    bottom: -10%;
    left: 30%;
    width: 46vw;
    height: 46vw;
    max-width: 520px;
    max-height: 520px;
    background: radial-gradient(circle, var(--violet) 0%, rgba(182, 156, 255, 0.02) 70%, transparent 100%);
    animation: drift-orb-violet 20s ease-in-out infinite alternate;
  }

  @keyframes drift-orb-emerald {
    0% { transform: translate3d(0, 0, 0) scale(1); }
    50% { transform: translate3d(50px, 40px, 0) scale(1.1); }
    100% { transform: translate3d(-40px, 55px, 0) scale(0.94); }
  }

  @keyframes drift-orb-cyan {
    0% { transform: translate3d(0, 0, 0) scale(0.95); }
    50% { transform: translate3d(-55px, -45px, 0) scale(1.08); }
    100% { transform: translate3d(40px, -30px, 0) scale(1.04); }
  }

  @keyframes drift-orb-violet {
    0% { transform: translate3d(0, 0, 0) scale(1.04); }
    50% { transform: translate3d(50px, -45px, 0) scale(0.94); }
    100% { transform: translate3d(-40px, 35px, 0) scale(1.1); }
  }

  @media (prefers-reduced-motion: reduce) {
    .aurora-orb {
      animation: none !important;
    }
  }
</style>
