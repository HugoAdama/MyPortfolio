---
// Aurora Borealis celestial ribbons & liquid glass ambient engine
---
<div class="aurora-bg" aria-hidden="true">
  <!-- Glowing Aurora Ambient Glow Orbs for deep atmospheric illumination -->
  <div class="aurora-orb orb-emerald"></div>
  <div class="aurora-orb orb-cyan"></div>
  <div class="aurora-orb orb-violet"></div>

  <!-- Real-time Aurora Borealis Canvas (Curtains of Light & Ray Striations) -->
  <canvas id="aurora-borealis-canvas" class="aurora-canvas"></canvas>
</div>

<script>
  function initAuroraBorealis() {
    const canvas = document.getElementById('aurora-borealis-canvas') as HTMLCanvasElement | null;
    if (!canvas) return;

    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    const mediaQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
    let prefersReducedMotion = mediaQuery.matches;
    mediaQuery.addEventListener('change', (e) => {
      prefersReducedMotion = e.matches;
    });

    let width = 0;
    let height = 0;
    let dpr = 1;

    // Starfield for deep polar night sky atmosphere
    interface Star {
      x: number;
      y: number;
      size: number;
      alpha: number;
      speed: number;
      phase: number;
    }
    let stars: Star[] = [];

    function initStars() {
      stars = [];
      const count = Math.min(Math.floor((width * height) / 14000), 75);
      for (let i = 0; i < count; i++) {
        stars.push({
          x: Math.random() * width,
          y: Math.random() * height * 0.85,
          size: Math.random() * 1.5 + 0.5,
          alpha: Math.random() * 0.7 + 0.2,
          speed: Math.random() * 0.03 + 0.01,
          phase: Math.random() * Math.PI * 2,
        });
      }
    }

    function resize() {
      if (!canvas) return;
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      width = window.innerWidth;
      height = window.innerHeight;
      canvas.width = width * dpr;
      canvas.height = height * dpr;
      canvas.style.width = `${width}px`;
      canvas.style.height = `${height}px`;
      if (ctx) {
        ctx.scale(dpr, dpr);
      }
      initStars();
    }

    resize();
    window.addEventListener('resize', resize, { passive: true });

    // Smooth mouse coordinates for celestial wind interaction
    let mouseX = width * 0.5;
    let mouseY = height * 0.4;
    let targetMouseX = mouseX;
    let targetMouseY = mouseY;

    window.addEventListener(
      'pointermove',
      (e) => {
        targetMouseX = e.clientX;
        targetMouseY = e.clientY;
      },
      { passive: true }
    );

    // 3 layered celestial Aurora Borealis curtains
    const auroraCurtains = [
      {
        baseYRatio: 0.35,
        curtainHeight: 320,
        wavelength: 0.0018,
        speed: 0.007,
        foldFreq: 0.005,
        foldSpeed: 0.012,
        baseAmp: 60,
        rayCount: 90,
        phase: 0,
        darkColors: {
          base: 'rgba(142, 230, 184, 0.42)',    // Ionized oxygen emerald/mint
          mid: 'rgba(111, 211, 255, 0.35)',     // Electric cyan
          top: 'rgba(182, 156, 255, 0.22)',     // Nitrogen purple/violet
        },
        lightColors: {
          base: 'rgba(5, 150, 105, 0.18)',
          mid: 'rgba(2, 132, 199, 0.14)',
          top: 'rgba(124, 58, 237, 0.08)',
        },
      },
      {
        baseYRatio: 0.58,
        curtainHeight: 380,
        wavelength: 0.0022,
        speed: -0.009,
        foldFreq: 0.006,
        foldSpeed: 0.016,
        baseAmp: 75,
        rayCount: 110,
        phase: 2.4,
        darkColors: {
          base: 'rgba(111, 211, 255, 0.45)',    // Cyan core fold
          mid: 'rgba(142, 230, 184, 0.36)',     // Emerald sheen
          top: 'rgba(182, 156, 255, 0.28)',     // Violet curtain crown
        },
        lightColors: {
          base: 'rgba(2, 132, 199, 0.20)',
          mid: 'rgba(5, 150, 105, 0.14)',
          top: 'rgba(124, 58, 237, 0.10)',
        },
      },
      {
        baseYRatio: 0.78,
        curtainHeight: 280,
        wavelength: 0.0015,
        speed: 0.006,
        foldFreq: 0.004,
        foldSpeed: 0.010,
        baseAmp: 50,
        rayCount: 80,
        phase: 4.8,
        darkColors: {
          base: 'rgba(182, 156, 255, 0.38)',    // Deep violet bottom
          mid: 'rgba(111, 211, 255, 0.30)',     // Cyan ribbon
          top: 'rgba(142, 230, 184, 0.16)',     // Mint whisper
        },
        lightColors: {
          base: 'rgba(124, 58, 237, 0.16)',
          mid: 'rgba(2, 132, 199, 0.12)',
          top: 'rgba(5, 150, 105, 0.06)',
        },
      },
    ];

    let isVisible = true;
    document.addEventListener('visibilitychange', () => {
      isVisible = !document.hidden;
      if (isVisible) {
        lastTime = performance.now();
        render();
      }
    });

    let lastTime = performance.now();
    let globalTime = 0;

    function render() {
      if (!isVisible) return;

      const now = performance.now();
      const delta = Math.min((now - lastTime) / 1000, 0.1);
      lastTime = now;

      if (!prefersReducedMotion) {
        globalTime += delta;
      }

      if (!ctx || !canvas) return;

      // Smooth cursor interpolation
      mouseX += (targetMouseX - mouseX) * 0.035;
      mouseY += (targetMouseY - mouseY) * 0.035;

      ctx.clearRect(0, 0, width, height);

      const isLight = document.documentElement.getAttribute('data-theme') === 'light';

      // 1. Draw subtle twinkling polar stars in dark mode
      if (!isLight) {
        for (let i = 0; i < stars.length; i++) {
          const s = stars[i];
          const twinkle = Math.sin(globalTime * 1.5 + s.phase) * 0.35 + 0.65;
          ctx.beginPath();
          ctx.arc(s.x, s.y, s.size, 0, Math.PI * 2);
          ctx.fillStyle = `rgba(232, 234, 246, ${s.alpha * twinkle * 0.75})`;
          ctx.fill();
        }
      }

      // 2. Render each Aurora Curtain with vertical light columns & wave folds
      ctx.globalCompositeOperation = isLight ? 'multiply' : 'screen';

      for (let c = 0; c < auroraCurtains.length; c++) {
        const curtain = auroraCurtains[c];

        if (!prefersReducedMotion) {
          curtain.phase += curtain.speed * delta * 60;
        }

        const colors = isLight ? curtain.lightColors : curtain.darkColors;
        const baseY = height * curtain.baseYRatio;
        const rays = curtain.rayCount;
        const stepX = width / rays;

        // Render each vertical curtain ray
        for (let r = 0; r <= rays; r++) {
          const x = r * stepX;

          // Influence of mouse proximity
          const distToMouse = Math.abs(x - mouseX);
          const mouseInfl = Math.max(0, 1 - distToMouse / (width * 0.4));
          const amp = curtain.baseAmp + mouseInfl * 24;

          // Undulating spine curve with secondary and tertiary harmonic folds
          const wave1 = Math.sin(x * curtain.wavelength + curtain.phase) * amp;
          const wave2 = Math.cos(x * curtain.foldFreq + curtain.phase * 1.4) * (amp * 0.45);
          const wave3 = Math.sin(x * 0.008 + globalTime * 0.8) * 8; // high frequency shimmer
          const spineY = baseY + wave1 + wave2 + wave3;

          // Ray vertical reach (folds in the aurora billow higher where the waves crest)
          const foldIntensity = Math.abs(Math.sin(x * curtain.wavelength * 1.8 + curtain.phase));
          const rayHeight = curtain.curtainHeight * (0.65 + foldIntensity * 0.55 + mouseInfl * 0.2);

          // Top of ray extends upward into the sky
          const topY = spineY - rayHeight;
          const botY = spineY + 30;

          // Vertical gradient for the aurora curtain fold
          const rayGrad = ctx.createLinearGradient(x, topY, x, botY);
          rayGrad.addColorStop(0, 'rgba(0,0,0,0)');
          rayGrad.addColorStop(0.25, colors.top);
          rayGrad.addColorStop(0.65, colors.mid);
          rayGrad.addColorStop(0.92, colors.base);
          rayGrad.addColorStop(1, 'rgba(0,0,0,0)');

          ctx.fillStyle = rayGrad;
          // Soft overlapping vertical beam strips
          ctx.fillRect(x - stepX * 0.8, topY, stepX * 1.8, botY - topY);
        }

        // Add a luminous glowing baseline ribbon through the curtain's crest
        ctx.beginPath();
        for (let x = 0; x <= width + 12; x += 12) {
          const distToMouse = Math.abs(x - mouseX);
          const mouseInfl = Math.max(0, 1 - distToMouse / (width * 0.4));
          const amp = curtain.baseAmp + mouseInfl * 24;

          const wave1 = Math.sin(x * curtain.wavelength + curtain.phase) * amp;
          const wave2 = Math.cos(x * curtain.foldFreq + curtain.phase * 1.4) * (amp * 0.45);
          const wave3 = Math.sin(x * 0.008 + globalTime * 0.8) * 8;
          const y = baseY + wave1 + wave2 + wave3;

          if (x === 0) {
            ctx.moveTo(x, y);
          } else {
            ctx.lineTo(x, y);
          }
        }
        ctx.strokeStyle = colors.base;
        ctx.lineWidth = 1.6;
        ctx.stroke();
      }

      ctx.globalCompositeOperation = 'source-over';
      requestAnimationFrame(render);
    }

    render();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAuroraBorealis);
  } else {
    initAuroraBorealis();
  }
  document.addEventListener('astro:page-load', initAuroraBorealis);
</script>

<style>
  .aurora-bg {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: -2;
    overflow: hidden;
    width: 100vw;
    height: 100vh;
    contain: strict;
    background: radial-gradient(circle at 50% 20%, rgba(20, 26, 56, 0.4) 0%, transparent 80%);
  }

  .aurora-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    display: block;
  }

  /* Bioluminescent Glow Orbs for ambient atmospheric lighting behind curtains */
  .aurora-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(95px);
    opacity: 0.35;
    will-change: transform, opacity;
    mix-blend-mode: screen;
  }

  [data-theme="light"] .aurora-orb {
    mix-blend-mode: multiply;
    opacity: 0.18;
    filter: blur(105px);
  }

  .orb-emerald {
    top: 15%;
    left: 8%;
    width: 52vw;
    height: 52vw;
    max-width: 620px;
    max-height: 620px;
    background: radial-gradient(circle, var(--mint) 0%, rgba(142, 230, 184, 0.02) 70%, transparent 100%);
    animation: drift-orb-emerald 16s ease-in-out infinite alternate;
  }

  .orb-cyan {
    top: 40%;
    right: 6%;
    width: 56vw;
    height: 56vw;
    max-width: 650px;
    max-height: 650px;
    background: radial-gradient(circle, var(--cyan) 0%, rgba(111, 211, 255, 0.02) 70%, transparent 100%);
    animation: drift-orb-cyan 18s ease-in-out infinite alternate;
  }

  .orb-violet {
    bottom: -10%;
    left: 30%;
    width: 48vw;
    height: 48vw;
    max-width: 550px;
    max-height: 550px;
    background: radial-gradient(circle, var(--violet) 0%, rgba(182, 156, 255, 0.02) 70%, transparent 100%);
    animation: drift-orb-violet 20s ease-in-out infinite alternate;
  }

  /* Smooth undulating drift for ambient light orbs */
  @keyframes drift-orb-emerald {
    0% {
      transform: translate3d(0, 0, 0) scale(1);
    }
    50% {
      transform: translate3d(60px, 45px, 0) scale(1.15);
    }
    100% {
      transform: translate3d(-45px, 65px, 0) scale(0.92);
    }
  }

  @keyframes drift-orb-cyan {
    0% {
      transform: translate3d(0, 0, 0) scale(0.94);
    }
    50% {
      transform: translate3d(-65px, -50px, 0) scale(1.12);
    }
    100% {
      transform: translate3d(45px, -35px, 0) scale(1.05);
    }
  }

  @keyframes drift-orb-violet {
    0% {
      transform: translate3d(0, 0, 0) scale(1.05);
    }
    50% {
      transform: translate3d(60px, -55px, 0) scale(0.92);
    }
    100% {
      transform: translate3d(-50px, 40px, 0) scale(1.15);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .aurora-orb {
      animation: none !important;
    }
  }
</style>
